    <!-- =========================================================
         JAVASCRIPT
    ========================================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {


            /* ==========================================
               MOBILE SIDEBAR
            ========================================== */

            const menuBtn =
                document.getElementById("menuBtn");

            const closeBtn =
                document.getElementById("closeBtn");

            const sidebar =
                document.getElementById("sidebar");


            if (menuBtn && closeBtn && sidebar) {


                function openSidebar() {

                    sidebar.classList.remove(
                        "translate-x-full"
                    );

                    sidebar.classList.add(
                        "translate-x-0"
                    );

                    document.body.classList.add(
                        "overflow-hidden"
                    );

                }


                function closeSidebar() {

                    sidebar.classList.remove(
                        "translate-x-0"
                    );

                    sidebar.classList.add(
                        "translate-x-full"
                    );

                    document.body.classList.remove(
                        "overflow-hidden"
                    );

                }


                menuBtn.addEventListener(
                    "click",
                    openSidebar
                );


                closeBtn.addEventListener(
                    "click",
                    closeSidebar
                );


                sidebar
                    .querySelectorAll("a")
                    .forEach(function (link) {

                        link.addEventListener(
                            "click",
                            closeSidebar
                        );

                    });


                document.addEventListener(
                    "keydown",
                    function (event) {

                        if (event.key === "Escape") {

                            closeSidebar();

                        }

                    }
                );


                window.addEventListener(
                    "resize",
                    function () {

                        if (window.innerWidth >= 768) {

                            closeSidebar();

                        }

                    }
                );

            }



            /* ==========================================
               STICKY NAVIGATION
            ========================================== */

            const navbar =
                document.getElementById("navbar");

            const contactBar =
                document.querySelector(
                    "header > div:first-child"
                );


            if (navbar) {


                function handleNavbarScroll() {


                    const triggerPoint =
                        contactBar
                            ? contactBar.offsetHeight
                            : 40;


                    if (window.scrollY > triggerPoint) {


                        navbar.classList.remove(
                            "absolute"
                        );


                        navbar.classList.add(
                            "fixed",
                            "bg-white",
                            "shadow-[0_2px_10px_rgba(0,0,0,0.06)]"
                        );


                        navbar
                            .querySelectorAll(
                                "div.flex.items-center > a, div.flex.items-center > div > a"
                            );


                        navbar
                            .querySelectorAll(
                                "div > div > a"
                            )
                            .forEach(function (link) {

                                link.classList.remove(
                                    "text-yellow-400"
                                );

                                link.classList.add(
                                    "text-green-800"
                                );

                            });


                        const menuButton =
                            document.getElementById(
                                "menuBtn"
                            );


                        if (menuButton) {

                            menuButton.classList.remove(
                                "text-yellow-400"
                            );

                            menuButton.classList.add(
                                "text-green-800"
                            );

                        }


                    } else {


                        navbar.classList.remove(
                            "fixed",
                            "bg-white",
                            "shadow-[0_2px_10px_rgba(0,0,0,0.06)]"
                        );


                        navbar.classList.add(
                            "absolute"
                        );


                        navbar
                            .querySelectorAll(
                                "div > div > a"
                            )
                            .forEach(function (link) {

                                link.classList.remove(
                                    "text-green-800"
                                );

                                link.classList.add(
                                    "text-yellow-400"
                                );

                            });


                        const menuButton =
                            document.getElementById(
                                "menuBtn"
                            );


                        if (menuButton) {

                            menuButton.classList.remove(
                                "text-green-800"
                            );

                            menuButton.classList.add(
                                "text-yellow-400"
                            );

                        }

                    }

                }


                window.addEventListener(
                    "scroll",
                    handleNavbarScroll,
                    {
                        passive: true
                    }
                );


                handleNavbarScroll();

            }

        });

    </script>

</body>

</html>